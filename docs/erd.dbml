// RaceDay - Entity Relationship Diagram
// PROG6212 Part 1
//
// Paste into https://dbdiagram.io to render in crow's-foot notation.
// This file is the source of truth for docs/erd.png and docs/erd.pdf and
// matches docs/raceday_schema.sql exactly (names, types, keys, constraints).

Project RaceDay {
  database_type: 'SQL Server'
  Note: '''
    Event management and participant tracking for running, walking and cycling events.
    Two roles: Organiser (creates events, records results) and Participant (enrols, views results).
  '''
}

// ---------------------------------------------------------------------------
// Lookup tables
// ---------------------------------------------------------------------------

Table Roles {
  RoleId int [pk, increment]
  Name nvarchar(50) [not null, unique, note: 'Organiser | Participant']
}

Table EventTypes {
  EventTypeId int [pk, increment]
  Name nvarchar(50) [not null, unique, note: 'Running | Walking | Cycling']
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

Table Users {
  UserId int [pk, increment]
  RoleId int [not null, ref: > Roles.RoleId]
  FirstName nvarchar(100) [not null]
  LastName nvarchar(100) [not null]
  Email nvarchar(256) [not null, unique]
  PasswordHash nvarchar(255) [not null, note: 'BCrypt hash, never plain text']
  Phone nvarchar(20)
  DateOfBirth date [not null]
  City nvarchar(100)
  CreatedAt datetime2 [not null, default: `SYSUTCDATETIME()`]

  Note: 'Custom users table so JWT auth in Part 2 does not depend on ASP.NET Identity.'
}

Table Events {
  EventId int [pk, increment]
  OrganiserId int [not null, ref: > Users.UserId]
  EventTypeId int [not null, ref: > EventTypes.EventTypeId]
  Name nvarchar(150) [not null]
  Description nvarchar(2000)
  EventDate date [not null]
  StartTime time [not null]
  Venue nvarchar(150) [not null]
  City nvarchar(100) [not null]
  Province nvarchar(100) [not null]
  Latitude decimal(9,6) [note: 'For live weather (Part 2)']
  Longitude decimal(9,6) [note: 'For live weather (Part 2)']
  RouteImageUrl nvarchar(500) [note: 'Azure Blob link (Part 3)']
  Status nvarchar(20) [not null, default: 'Published', note: 'Draft | Published | Cancelled | Completed']
  CreatedAt datetime2 [not null, default: `SYSUTCDATETIME()`]

  indexes {
    EventDate
    OrganiserId
  }
}

Table Categories {
  CategoryId int [pk, increment]
  EventId int [not null, ref: > Events.EventId, note: 'ON DELETE CASCADE']
  Name nvarchar(100) [not null, note: 'e.g. 21.1km Half Marathon']
  DistanceKm decimal(6,2) [not null, note: 'CHECK > 0']
  EntryFee decimal(10,2) [not null, note: 'CHECK >= 0']
  MaxParticipants int [not null, note: 'CHECK > 0']
  MinAge int [not null, default: 0]

  indexes {
    (EventId, Name) [unique]
  }
}

// ---------------------------------------------------------------------------
// Junction: Users M:M Categories
// ---------------------------------------------------------------------------
